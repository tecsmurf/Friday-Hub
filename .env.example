# Friday Hub environment example.
# Copy this file to .env for local development.

OLLAMA_HOST=http://localhost:11434
OLLAMA_BRAIN_MODEL=qwen3:4b
OLLAMA_FAST_MODEL=qwen2.5-coder:3b

# Optional cloud fallback. Leave empty if you only want local Ollama.
OPENROUTER_API_KEY=
OPENROUTER_BRAIN_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_FAST_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Optional CLI command overrides if the tools are not on PATH.
CLAUDE_CODE_CMD=claude
CODEX_CMD=codex
OPENCLAW_CMD=openclaw

# Optional advanced paths.
# FRIDAY_CONFIG=C:\path\to\friday.yaml
# FRIDAY_ENV_FILE=C:\path\to\.env
# FRIDAY_HOME=C:\path\to\friday-data
